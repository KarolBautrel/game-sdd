{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-game/dungeon.schema.json",
  "type": "object",
  "required": ["id", "display_name", "recommended_party_level", "start_room_id", "rooms", "corridors", "exit_rules"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "recommended_party_level": { "type": "integer", "minimum": 1 },
    "start_room_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "max_light_level": { "type": "integer", "minimum": 1 },
    "hazard_seed": { "type": "integer" },
    "starting_supplies": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "supply_loadout_capacity": { "type": "integer", "minimum": 0 },
    "supply_loadout_options": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/supply_loadout_option" }
    },
    "generated_profile": { "$ref": "#/$defs/generated_profile" },
    "default_party_formation": {
      "type": "array",
      "items": { "$ref": "#/$defs/party_formation_slot" }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "kind", "position", "content"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "display_name": { "type": "string", "minLength": 1 },
          "locked_by_item_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "kind": {
            "type": "string",
            "enum": ["entrance", "empty", "treasure", "combat", "guarded_treasure", "quest", "exit"]
          },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" }
            }
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["empty", "treasure", "combat", "guarded_treasure", "quest", "room_event"]
                },
                "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "event_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "room_event_pool_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "combat_encounter_path": {
                  "type": "string",
                  "pattern": "^res://resources/data/combat_encounters/.+\\.json$"
                },
                "quest_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "rewards": { "$ref": "#/$defs/rewards" }
              }
            }
          }
        }
      }
    },
    "corridors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "from": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "to": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "danger": { "type": "number", "minimum": 0, "maximum": 1 },
          "light_decay": { "type": "integer", "minimum": 0 },
          "hazards": {
            "type": "array",
            "items": { "$ref": "#/$defs/hazard" }
          },
          "hazard_refs": {
            "type": "array",
            "items": { "$ref": "#/$defs/hazard_ref" }
          },
          "hazard_pool_refs": {
            "type": "array",
            "items": { "$ref": "#/$defs/hazard_pool_ref" }
          }
        }
      }
    },
    "exit_rules": {
      "type": "object",
      "required": ["allow_retreat", "boss_required"],
      "additionalProperties": false,
      "properties": {
        "allow_retreat": { "type": "boolean" },
        "boss_required": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "hazard": {
      "type": "object",
      "required": ["id", "type", "trigger", "required_supply_id", "outcomes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "type": { "type": "string", "enum": ["rubble", "darkness", "trap", "noise", "blockage", "generic"] },
        "message": { "type": "string" },
        "trigger": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["first_traversal", "always"] }
          }
        },
        "required_supply_id": { "type": "string", "pattern": "^[a-z0-9_]*$" },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/hazard_choice" }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hazard_outcome" }
        }
      }
    },
    "hazard_ref": {
      "type": "object",
      "required": ["id", "event_id", "trigger"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "event_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "trigger": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["first_traversal", "always"] }
          }
        }
      }
    },
    "hazard_pool_ref": {
      "type": "object",
      "required": ["id", "pool_id", "trigger"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "pool_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "trigger": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["first_traversal", "always"] }
          }
        }
      }
    },
    "supply_loadout_option": {
      "type": "object",
      "required": ["min", "max", "default"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "default": { "type": "integer", "minimum": 0 },
        "packing_cost": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "generated_profile": {
      "type": "object",
      "required": ["id", "display_name", "difficulty", "theme"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "display_name": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
        "theme": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "length": { "type": "string", "enum": ["short", "medium", "deep"] }
      }
    },
    "party_formation_slot": {
      "type": "object",
      "required": ["slot_id", "target_id", "combat_unit_id", "label"],
      "additionalProperties": false,
      "properties": {
        "slot_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "target_id": { "type": "string", "pattern": "^party_slot_[a-z0-9_]+$" },
        "combat_unit_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "hazard_choice": {
      "type": "object",
      "required": ["id", "label", "requires_supply"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "enum": ["use_supply", "force_passage"] },
        "label": { "type": "string", "minLength": 1 },
        "requires_supply": { "type": "boolean" }
      }
    },
    "hazard_outcome": {
      "type": "object",
      "required": ["id", "when", "message", "consequences"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "when": {
          "type": "object",
          "required": ["choice_id"],
          "additionalProperties": false,
          "properties": {
            "choice_id": { "type": "string", "enum": ["use_supply", "force_passage"] },
            "has_supply": { "type": "boolean" }
          }
        },
        "weight": { "type": "integer", "minimum": 1 },
        "consume_required_supply": { "type": "boolean" },
        "blocks_traversal": { "type": "boolean" },
        "message": { "type": "string", "minLength": 1 },
        "consequences": {
          "type": "array",
          "items": { "$ref": "#/$defs/hazard_consequence" }
        }
      }
    },
    "hazard_consequence": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["consume_supply", "reduce_light", "restore_light", "apply_debuff", "hp_loss", "log_only"]
        },
        "amount": { "type": "integer", "minimum": 0 },
        "stacks": { "type": "integer", "minimum": 1 },
        "supply_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "debuff_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "target_id": { "type": "string", "pattern": "^[a-z0-9_]+$" }
      }
    },
    "rewards": {
      "type": "object",
      "required": ["xp", "gold", "items"],
      "additionalProperties": false,
      "properties": {
        "xp": { "type": "integer", "minimum": 0 },
        "gold": { "type": "integer", "minimum": 0 },
        "items": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "uniqueItems": true
        }
      }
    }
  }
}
