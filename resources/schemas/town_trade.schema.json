{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "town_id", "offers"],
  "properties": {
    "schema": {"const": "sdd.town-trade-v1"},
    "town_id": {"const": "town_ravenford"},
    "offers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_id", "buy_price"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "buy_price": {"type": "integer", "minimum": 1, "maximum": 1000000000}
        }
      }
    }
  }
}
