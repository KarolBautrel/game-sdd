{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-game/combat_encounter.schema.json",
  "type": "object",
  "required": ["id", "seed", "units", "turn_state", "event_log"],
  "additionalProperties": false,
  "anyOf": [
    { "required": ["grid"] },
    { "required": ["map_path"] }
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "seed": { "type": "integer", "minimum": 0 },
    "background_path": { "type": "string", "pattern": "^res://assets/combat/terrain/backgrounds/.+\\.png$" },
    "map_path": { "type": "string", "pattern": "^res://resources/data/maps/.+\\.json$" },
    "grid": {
      "type": "object",
      "required": ["width", "height", "tiles"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["x", "y", "type"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "type": { "type": "string", "enum": ["floor", "blocked", "highground", "cover_low"] }
            }
          }
        }
      }
    },
    "weapon_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "action_id", "range", "ap_cost"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "action_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "range": { "type": "integer", "minimum": 1 },
          "ap_cost": { "type": "integer", "minimum": 0 },
          "base_hit_chance": { "type": "integer", "minimum": 0, "maximum": 100 },
          "damage_bonus": { "type": "integer" },
          "cooldown_turns": { "type": "integer", "minimum": 0 },
          "status_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "status_remaining_turns": { "type": "integer", "minimum": 0 },
          "damage_reduction": { "type": "integer", "minimum": 0 },
          "status_tick_damage": { "type": "integer", "minimum": 0 },
          "status_defense_modifier": { "type": "integer" }
        }
      }
    },
    "action_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "action_id", "ap_cost"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "action_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "range": { "type": "integer", "minimum": 1 },
          "ap_cost": { "type": "integer", "minimum": 0 },
          "base_hit_chance": { "type": "integer", "minimum": 0, "maximum": 100 },
          "damage_bonus": { "type": "integer" },
          "cooldown_turns": { "type": "integer", "minimum": 0 },
          "status_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "status_remaining_turns": { "type": "integer", "minimum": 0 },
          "damage_reduction": { "type": "integer", "minimum": 0 },
          "status_tick_damage": { "type": "integer", "minimum": 0 },
          "status_defense_modifier": { "type": "integer" }
        }
      }
    },
    "item_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "slot", "grants_actions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "slot": { "type": "string", "enum": ["main_hand", "off_hand", "armor"] },
          "two_handed": { "type": "boolean" },
          "armor_reduction": { "type": "integer", "minimum": 0 },
          "grants_actions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "uniqueItems": true
          },
          "action_profiles": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["id", "action_id", "ap_cost"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "action_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "range": { "type": "integer", "minimum": 1 },
                "ap_cost": { "type": "integer", "minimum": 0 },
                "base_hit_chance": { "type": "integer", "minimum": 0, "maximum": 100 },
                "damage_bonus": { "type": "integer" },
                "cooldown_turns": { "type": "integer", "minimum": 0 },
                "status_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "status_remaining_turns": { "type": "integer", "minimum": 0 },
                "damage_reduction": { "type": "integer", "minimum": 0 },
                "status_tick_damage": { "type": "integer", "minimum": 0 },
                "status_defense_modifier": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "enemy_archetypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "available_actions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "available_actions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "uniqueItems": true
          },
          "loadout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "main_hand": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
              "off_hand": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
              "armor": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" }
            }
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "team", "position", "stats", "resources", "statuses", "available_actions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "team": { "type": "string", "enum": ["player", "enemy"] },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 }
            }
          },
          "stats": {
            "type": "object",
            "required": ["max_hp", "strength", "defense", "initiative", "move_points", "max_ap"],
            "additionalProperties": false,
            "properties": {
              "max_hp": { "type": "integer", "minimum": 1 },
              "strength": { "type": "integer", "minimum": 0 },
              "defense": { "type": "integer", "minimum": 0 },
              "initiative": { "type": "integer", "minimum": 0 },
              "move_points": { "type": "integer", "minimum": 0 },
              "max_ap": { "type": "integer", "minimum": 0 },
              "accuracy": { "type": "integer" },
              "evasion": { "type": "integer" }
            }
          },
          "resources": {
            "type": "object",
            "required": ["hp", "ap"],
            "additionalProperties": false,
            "properties": {
              "hp": { "type": "integer", "minimum": 0 },
              "ap": { "type": "integer", "minimum": 0 },
              "mp": { "type": "integer", "minimum": 0 }
            }
          },
          "statuses": {
            "type": "array",
            "items": { "type": "object" }
          },
          "available_actions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "uniqueItems": true
          },
          "learned_actions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "uniqueItems": true
          },
          "archetype_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "equipped_weapon_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "visual": {
            "type": "object",
            "required": ["faction", "character"],
            "additionalProperties": false,
            "properties": {
              "faction": { "type": "string", "enum": ["heroes", "villains"] },
              "character": { "type": "string", "pattern": "^[a-z0-9_]+$" }
            }
          },
          "loadout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "main_hand": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
              "off_hand": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
              "armor": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" }
            }
          }
        }
      }
    },
    "turn_state": {
      "type": "object",
      "required": ["active_unit_id", "round", "turn_order"],
      "additionalProperties": false,
      "properties": {
        "active_unit_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "round": { "type": "integer", "minimum": 1 },
        "turn_order": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        }
      }
    },
    "event_log": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
