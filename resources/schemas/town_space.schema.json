{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object", "additionalProperties":false,
  "required":["schema","id","map_path","entry_spawn","npcs"],
  "properties":{
    "schema":{"const":"sdd.town-space-v1"},
    "id":{"type":"string","pattern":"^[a-z0-9_]+$"},
    "map_path":{"type":"string","pattern":"^res://resources/data/maps/[a-z0-9_]+\\.json$"},
    "entry_spawn":{"type":"string","minLength":1},
    "npcs":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","name","spawn_id","profile","dialogue","service_hint"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9_]+$"},
        "name":{"type":"string","minLength":1},
        "spawn_id":{"type":"string","minLength":1},
        "profile":{"type":"string","minLength":1},
        "dialogue":{"type":"string","minLength":1},
        "service_hint":{"type":"string","minLength":1}
      }
    }}
  }
}
