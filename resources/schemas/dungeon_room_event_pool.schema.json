{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-game/dungeon_room_event_pool.schema.json",
  "type": "object",
  "required": ["id", "pools"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pool" }
    }
  },
  "$defs": {
    "pool": {
      "type": "object",
      "required": ["id", "tags", "entries"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "uniqueItems": true
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pool_entry" }
        }
      }
    },
    "pool_entry": {
      "type": "object",
      "required": ["event_id", "weight"],
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "weight": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
