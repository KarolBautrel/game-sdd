{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "seed",
    "preset",
    "attempt",
    "name",
    "terrain",
    "sites",
    "roads",
    "road_paths",
    "rivers",
    "bridges",
    "diagnostics",
    "checksum"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "preset": {
      "enum": [
        "marches",
        "woodland",
        "highlands"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "region",
        "revision",
        "width",
        "height",
        "rows",
        "crossings"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "region": {
          "const": "living_marches_v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "enum": [
            192,
            384,
            768
          ]
        },
        "height": {
          "type": "integer",
          "enum": [
            108,
            216,
            432
          ]
        },
        "rows": {
          "type": "array",
          "minItems": 108,
          "maxItems": 432,
          "items": {
            "type": "string",
            "minLength": 192,
            "maxLength": 768,
            "pattern": "^[RPFHMWXB]+$"
          }
        },
        "crossings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "position"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "owner",
          "position"
        ],
        "properties": {
          "id": {
            "enum": [
              "town_ravenford",
              "saltwatch",
              "black_keep",
              "dungeon_old_mine",
              "high_pass",
              "sunken_abbey"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "town",
              "dungeon",
              "landmark"
            ]
          },
          "owner": {
            "enum": [
              "river_league",
              "iron_march",
              "bandits",
              "neutral"
            ]
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              }
            }
          }
        }
      }
    },
    "roads": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            }
          }
        }
      }
    },
    "road_paths": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "array",
        "maxItems": 2000,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        "minItems": 2
      }
    },
    "rivers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "points",
          "profile"
        ],
        "properties": {
          "points": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1
                }
              }
            }
          },
          "profile": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        }
      }
    },
    "bridges": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "position",
          "from",
          "to",
          "orientation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              }
            }
          },
          "from": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              }
            }
          },
          "to": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              }
            }
          },
          "orientation": {
            "enum": [
              "ne",
              "nw"
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "land_cells",
        "connected_cells",
        "bridges"
      ],
      "properties": {
        "land_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 331776
        },
        "connected_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 331776
        },
        "bridges": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        }
      }
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "climates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "radius"
        ],
        "properties": {
          "id": {
            "enum": [
              "wetwood",
              "drylands",
              "uplands"
            ]
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              }
            }
          },
          "radius": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 0.5
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "terrain": {
            "properties": {
              "width": {
                "const": 192
              },
              "height": {
                "const": 108
              },
              "rows": {
                "minItems": 108,
                "maxItems": 108,
                "items": {
                  "minLength": 192,
                  "maxLength": 192
                }
              }
            }
          },
          "diagnostics": {
            "properties": {
              "land_cells": {
                "maximum": 20736
              },
              "connected_cells": {
                "maximum": 20736
              }
            }
          }
        },
        "not": {
          "required": [
            "climates"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "terrain": {
            "properties": {
              "width": {
                "const": 384
              },
              "height": {
                "const": 216
              },
              "rows": {
                "minItems": 216,
                "maxItems": 216,
                "items": {
                  "minLength": 384,
                  "maxLength": 384
                }
              }
            }
          },
          "diagnostics": {
            "properties": {
              "land_cells": {
                "maximum": 82944
              },
              "connected_cells": {
                "maximum": 82944
              }
            }
          }
        },
        "required": [
          "climates"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "terrain": {
            "properties": {
              "width": {
                "const": 768
              },
              "height": {
                "const": 432
              },
              "rows": {
                "minItems": 432,
                "maxItems": 432,
                "items": {
                  "minLength": 768,
                  "maxLength": 768
                }
              }
            }
          },
          "diagnostics": {
            "properties": {
              "land_cells": {
                "maximum": 331776
              },
              "connected_cells": {
                "maximum": 331776
              }
            }
          }
        },
        "required": [
          "climates"
        ]
      }
    }
  ]
}
