{
  "type": "object",
  "properties": {
    "schema": {
      "const": "sdd.strategist-replay"
    },
    "version": {
      "const": 1
    },
    "checkpoint": {
      "type": "string",
      "pattern": "^res://resources/data/strategist_campaigns/[a-z0-9_]+[.]json$"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "action": {
            "type": "string",
            "maxLength": 128
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "sequence",
          "action",
          "payload"
        ],
        "additionalProperties": false
      },
      "maxItems": 2048,
      "uniqueItems": false
    },
    "expected_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema",
    "version",
    "checkpoint",
    "commands",
    "expected_digest"
  ],
  "additionalProperties": false
}
