{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-game/combat_action.schema.json",
  "type": "object",
  "required": ["id", "targeting", "cost", "effects"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "targeting": {
      "type": "object",
      "required": ["type", "range", "requires_line_of_sight"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["single_enemy", "single_ally", "self", "area"] },
        "range": { "type": "integer", "minimum": 0 },
        "requires_line_of_sight": { "type": "boolean" }
      }
    },
    "cost": {
      "type": "object",
      "required": ["ap"],
      "additionalProperties": false,
      "properties": {
        "ap": { "type": "integer", "minimum": 0 }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["damage", "defense_stance"] },
          "formula": { "type": "string" },
          "minimum": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}

