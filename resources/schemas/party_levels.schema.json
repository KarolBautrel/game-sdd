{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,"required":["schema","levels"],
  "properties":{
    "schema":{"const":"sdd.party-levels-v1"},
    "levels":{"type":"array","minItems":4,"maxItems":4,"items":{
      "type":"object","additionalProperties":false,"required":["level","cost","bonuses"],
      "properties":{
        "level":{"type":"integer","minimum":1,"maximum":4},
        "cost":{"type":"integer","minimum":0,"maximum":1000000},
        "bonuses":{"type":"object","additionalProperties":false,"properties":{
          "strength":{"type":"integer","minimum":0,"maximum":10},
          "defense":{"type":"integer","minimum":0,"maximum":10},
          "accuracy":{"type":"integer","minimum":0,"maximum":10}
        }}
      }
    }}
  }
}
