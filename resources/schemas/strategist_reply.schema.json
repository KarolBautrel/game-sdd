{
  "type": "object",
  "properties": {
    "schema": {
      "const": "sdd.strategist-reply"
    },
    "version": {
      "const": 1
    },
    "decision_id": {
      "type": "string",
      "pattern": "^decision_[0-9]{8,}$"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "intent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "maxItems": 3,
      "uniqueItems": true
    },
    "supporting": {
      "type": "array",
      "items": {
        "enum": [
          "trade",
          "guard",
          "rebuild"
        ]
      },
      "maxItems": 2,
      "uniqueItems": true
    },
    "contingencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "predicate": {
            "enum": [
              "food_below_target",
              "at_war",
              "trade_offer_waiting"
            ]
          },
          "intent_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "required": [
          "predicate",
          "intent_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 2,
      "uniqueItems": true
    },
    "reason_code": {
      "enum": [
        "reserve_deficit",
        "profitable_exports",
        "actual_war",
        "war_costs",
        "contested_supply_claim",
        "rebuild_reserves",
        "honour_agreement",
        "protect_trade"
      ]
    },
    "cited_events": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "maxItems": 4,
      "uniqueItems": true
    },
    "public_summary": {
      "type": "string",
      "maxLength": 180
    },
    "policy_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^request_[0-9]{8,}$"
    },
    "faction_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "observation_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "apply_by_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "requested_review_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "horizon_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "observation_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema",
    "version",
    "decision_id",
    "goal_id",
    "intent_ids",
    "supporting",
    "contingencies",
    "reason_code",
    "cited_events",
    "public_summary",
    "policy_version",
    "request_id",
    "faction_id",
    "generation",
    "observation_tick",
    "apply_by_tick",
    "requested_review_tick",
    "horizon_tick",
    "observation_hash"
  ],
  "additionalProperties": false
}
