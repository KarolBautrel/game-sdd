{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-game/combat_command.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "type", "actor_id", "action_id", "target"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
      "type": { "type": "string", "enum": ["perform_action"] },
      "actor_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
      "action_id": { "type": "string", "enum": ["basic_attack", "ranged_attack", "aimed_shot", "power_strike", "deep_cut", "guard_break", "shield_wall", "move", "defend", "end_turn"] },
      "target": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["unit", "tile", "none"] },
          "unit_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
