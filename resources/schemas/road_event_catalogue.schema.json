{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "cart",
    "ambush"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sdd.road-events-v1"
    },
    "cart": {
      "type": "object",
      "required": [
        "title",
        "description",
        "choices"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "gold_cost",
              "time_hours",
              "rewards"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "gold_cost": {
                "type": "integer",
                "minimum": 0
              },
              "time_hours": {
                "type": "integer",
                "minimum": 0
              },
              "rewards": {
                "$ref": "#/$defs/rewards"
              }
            }
          }
        }
      }
    },
    "ambush": {
      "type": "object",
      "required": [
        "title",
        "description",
        "encounter_path",
        "toll_gold",
        "victory_rewards"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "encounter_path": {
          "type": "string",
          "pattern": "^res://resources/data/combat_encounters/[a-z0-9_]+\\.json$"
        },
        "toll_gold": {
          "type": "integer",
          "minimum": 0
        },
        "victory_rewards": {
          "$ref": "#/$defs/rewards"
        }
      }
    }
  },
  "$defs": {
    "rewards": {
      "type": "object",
      "required": [
        "gold",
        "xp",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "gold": {
          "type": "integer",
          "minimum": 0
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
