{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-game/dungeon_combat_encounter_pool.schema.json",
  "type": "object",
  "required": ["id", "pools"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pool" }
    }
  },
  "$defs": {
    "pool": {
      "type": "object",
      "required": ["id", "theme", "entries"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "theme": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "encounter_path", "weight", "profile_ids", "difficulty_min", "difficulty_max", "room_kinds", "tactical_role"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "encounter_path": {
          "type": "string",
          "pattern": "^res://resources/data/combat_encounters/.+\\.json$"
        },
        "weight": { "type": "integer", "minimum": 1 },
        "profile_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["short_mine", "medium_mine", "deep_mine"]
          },
          "uniqueItems": true
        },
        "difficulty_min": { "type": "integer", "minimum": 1, "maximum": 3 },
        "difficulty_max": { "type": "integer", "minimum": 1, "maximum": 3 },
        "room_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["combat", "guarded_treasure"]
          },
          "uniqueItems": true
        },
        "tactical_role": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "notes": { "type": "string" }
      }
    }
  }
}
