          "message": "The pickaxe clears the rubble before anyone is hurt.",
          "consequences": []
        },
        {
          "id": "bruised_by_rubble",
          "when": { "choice_id": "force_passage" },
          "weight": 80,
          "message": "The party forces through the rubble and takes a bruising hit.",
          "consequences": [
            { "type": "hp_loss", "amount": 2, "target_id": "party_slot_front" },
            { "type": "apply_debuff", "debuff_id": "bruised", "target_id": "party_slot_front" }
          ]
        },
        {
          "id": "strained_by_rubble",
          "when": { "choice_id": "force_passage" },
          "weight": 20,
          "message": "The party shifts the rubble by hand, but the effort strains someone's back.",
          "consequences": [
            { "type": "hp_loss", "amount": 1, "target_id": "party_slot_front" },
            { "type": "apply_debuff", "debuff_id": "strained_back", "target_id": "party_slot_front" }
          ]
        }
      ]
    },
    {
