      "type": "rubble",
      "tags": ["mine", "corridor", "rubble", "tool_check"],
      "message": "A collapsed pile of mine stone blocks the passage.",
      "required_supply_id": "pickaxe",
      "choices": [
        { "id": "use_supply", "label": "Use pickaxe", "requires_supply": true },
        { "id": "force_passage", "label": "Force passage", "requires_supply": false }
