{
  "id": "base_corridor_hazards",
  "events": [
    {
      "id": "rubble_minor",
      "type": "rubble",
      "tags": ["mine", "corridor", "rubble", "tool_check"],
      "message": "A collapsed pile of mine stone blocks the passage.",
      "required_supply_id": "pickaxe",
      "choices": [
        { "id": "use_supply", "label": "Use pickaxe", "requires_supply": true },
        { "id": "force_passage", "label": "Force passage", "requires_supply": false }
      ],
      "outcomes": [
        {
          "id": "cleared_with_pickaxe",
          "when": { "choice_id": "use_supply", "has_supply": true },
          "consume_required_supply": true,
          "message": "The pickaxe clears the rubble before anyone is hurt.",
          "consequences": []
        },
        {
          "id": "bruised_by_rubble",
          "when": { "choice_id": "force_passage" },
          "weight": 80,
          "message": "The party forces through the rubble and takes a bruising hit.",
          "consequences": [
            { "type": "hp_loss", "amount": 2, "target_id": "party_slot_front" },
            { "type": "apply_debuff", "debuff_id": "bruised", "target_id": "party_slot_front" }
          ]
        },
        {
          "id": "strained_by_rubble",
          "when": { "choice_id": "force_passage" },
          "weight": 20,
          "message": "The party shifts the rubble by hand, but the effort strains someone's back.",
          "consequences": [
            { "type": "hp_loss", "amount": 1, "target_id": "party_slot_front" },
            { "type": "apply_debuff", "debuff_id": "strained_back", "target_id": "party_slot_front" }
          ]
        }
      ]
    },
    {
      "id": "needle_trap_basic",
      "type": "trap",
      "tags": ["mine", "corridor", "trap", "tool_check"],
      "message": "A thin tripwire disappears into a rusted needle trap along the tunnel wall.",
      "required_supply_id": "trap_tools",
      "choices": [
        { "id": "use_supply", "label": "Use trap tools", "requires_supply": true },
        { "id": "force_passage", "label": "Force passage", "requires_supply": false }
      ],
      "outcomes": [
        {
          "id": "trap_disarmed",
          "when": { "choice_id": "use_supply", "has_supply": true },
          "consume_required_supply": true,
          "message": "The trap tools catch the tripwire and disarm the needle mechanism.",
          "consequences": []
        },
        {
          "id": "poisoned_by_needle_trap",
          "when": { "choice_id": "force_passage" },
          "weight": 70,
          "message": "The party pushes through and a hidden needle bites into exposed skin.",
          "consequences": [
            { "type": "hp_loss", "amount": 1, "target_id": "party_slot_front" },
            { "type": "apply_debuff", "debuff_id": "poisoned", "target_id": "party_slot_front" }
          ]
        },
        {
          "id": "cut_by_needle_trap",
          "when": { "choice_id": "force_passage" },
          "weight": 30,
          "message": "The party avoids the needle reservoir, but the trap blade opens a bleeding cut.",
          "consequences": [
            { "type": "hp_loss", "amount": 1, "target_id": "party_slot_front" },
            { "type": "apply_debuff", "debuff_id": "bleeding", "target_id": "party_slot_front" }
          ]
        }
      ]
    }
  ]
}
