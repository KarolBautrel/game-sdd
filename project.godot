; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="sdd-game"
run/main_scene="res://scenes/dungeon/DungeonDebug.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DungeonRunSession="*res://scripts/session/dungeon_run_session.gd"
CampaignSession="*res://scripts/session/campaign_session.gd"
ExportProbe="*res://scripts/qa/export_probe.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[input]

living_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":32)]
}
living_speed_1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":49)]
}
living_speed_2={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":50)]
}
living_speed_4={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":52)]
}

[editor_plugins]

enabled=PackedStringArray("res://addons/theme_gen_save_sync/plugin.cfg", "res://addons/campaign_ui_theme/plugin.cfg")

[rendering]

rendering_device/driver.windows="d3d12"
