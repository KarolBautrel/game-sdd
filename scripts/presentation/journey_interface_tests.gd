extends SceneTree
var errors: Array[String] = []
var checks := 0
func _initialize() -> void: _run.call_deferred()
func check(ok: bool,message: String) -> void:
	checks += 1
	if not ok: errors.append(message)
func frames() -> void:
	for frame in range(5): await process_frame
func _run() -> void:
	var campaign := root.get_node("CampaignSession")
	campaign.load_profile("",true)
	var app: Control = load("res://scenes/town/town_shell.tscn").instantiate()
	root.add_child(app)
	await frames()
	app.action_buttons.buy_food.pressed.emit()
	await frames()
	check(campaign.state.gold == 39 and campaign.state.supplies.food == 4,"actual supply tile trusted price/quantity")
	app.shell.nav_buttons.region.pressed.emit()
	await frames()
	var map := app.find_child("RegionMap",true,false)
	check(map.marker_buttons.size() == 5 and map.marker_buttons.town_ravenford.disabled and not map.marker_buttons.dungeon_old_mine.disabled,"province landmarks/current/route availability")
	var before: Dictionary = campaign.state.duplicate(true)
	map.marker_buttons.town_ravenford.pressed.emit()
	check(campaign.state == before,"current marker never charges")
	map.marker_buttons.dungeon_old_mine.pressed.emit()
	await frames()
	check(campaign.state==before and app.journey_destination=="dungeon_old_mine","map preview has no travel/resource/event mutation")
	app._preview_journey("event_broken_cart")
	await frames()
	app._preview_journey("dungeon_old_mine")
	await frames()
	check(campaign.state==before,"Repeated previews do not reroll risk or charge time/food")
	check(app.find_child("JourneyArrival",true,false).text.contains("Day 1  14:00"),"arrival quote uses authored six-hour route")
	check(app.find_child("JourneyReserve",true,false).text.contains("After travel: 3 food") and app.find_child("JourneyReserve",true,false).text.contains("Keep 1 for return"),"route plan separates trip charge and retained reserve")
	app.action_buttons.travel_confirm.pressed.emit()
	await frames()
	map = app.find_child("RegionMap",true,false)
	check(campaign.state.world.location_id == "dungeon_old_mine" and campaign.state.supplies.food == 3 and campaign.state.world.elapsed_hours == 6,"actual map travel once")
	before=campaign.state.duplicate(true)
	app._confirm_journey()
	check(campaign.state==before,"duplicate confirmation cannot charge again")
	check(not map.marker_buttons.event_broken_cart.disabled,"nonadjacent landmark can now preview a multi-leg route")
	map.marker_buttons.town_ravenford.pressed.emit()
	await frames()
	app.action_buttons.travel_confirm.pressed.emit()
	await frames()
	map = app.find_child("RegionMap",true,false)
	map.marker_buttons.event_broken_cart.pressed.emit()
	await frames()
	app.action_buttons.travel_confirm.pressed.emit()
	await frames()
	map = app.find_child("RegionMap",true,false)
	check(campaign.state.world.pending_event.kind == "cart" and app.action_buttons.has("event_salvage"),"map travel preserves real event choices")
	for button: Button in map.marker_buttons.values(): check(button.disabled,"pending event locks every map marker")
	app.action_buttons.event_help.pressed.emit()
	await frames()
	map = app.find_child("RegionMap",true,false)
	map.marker_buttons.town_ravenford.pressed.emit()
	await frames()
	app.action_buttons.travel_confirm.pressed.emit()
	await frames()
	# Low-food fixture checks the new map input boundary as well as model rejection.
	campaign.load_profile("",true)
	campaign.state.supplies.food = 0
	app._render()
	await frames()
	map = app.find_child("RegionMap",true,false)
	before = campaign.state.duplicate(true)
	check(not map.marker_buttons.dungeon_old_mine.disabled,"underfunded route remains inspectable")
	map.marker_buttons.dungeon_old_mine.pressed.emit()
	await frames()
	check(campaign.state == before and app.action_buttons.travel_confirm.disabled,"underfunded plan explains but cannot confirm")
	app.action_buttons.travel_confirm.pressed.emit()
	check(campaign.state==before,"backend rejects even a synthesized disabled confirmation")
	app.action_buttons.travel_cancel.pressed.emit()
	await frames()
	check(campaign.state==before and app.journey_destination.is_empty(),"cancellation is presentation-only")
	check(app.action_buttons.travel_dungeon_old_mine.has_focus(),"cancel returns native focus to route choice")
	app.queue_free()
	await frames()
	for error in errors: push_error(error)
	print("journey_interface_tests: ",checks," checks, ",errors.size()," failures")
	quit(0 if errors.is_empty() else 1)
