extends SceneTree
const BRAN := "unit_player_001"
const TORIN := "unit_player_002"
var checks:=0
var failures: Array[String]=[]
func _initialize() -> void: _run.call_deferred()
func check(ok: bool,message: String) -> void:
	checks+=1
	if not ok: failures.append(message)
func frames() -> void:
	for frame in range(6): await process_frame
func _run() -> void:
	var campaign=root.get_node("CampaignSession")
	campaign.load_profile("",true)
	campaign.state.items.append_array(["hero_greatsword","salvaged_shield","patched_leather","patched_leather"])
	for index in range(60): campaign.state.items.append("retained_legacy_item_%s" % index)
	var app=load("res://scenes/app/App.tscn").instantiate()
	root.add_child(app)
	await frames()
	app._open_stash()
	await frames()
	var inventory=app.find_child("InventoryView",true,false)
	var gear=app.find_child("EquipmentView",true,false)
	var before: Dictionary=campaign.state.duplicate(true)
	inventory.grid.item_buttons.hero_bow.pressed.emit()
	await frames()
	check(campaign.state==before,"Item selection does not mutate profile")
	check(gear.ownership_label.text.contains("Available 0") and gear.ownership_label.text.contains("Torin (Weapon)"),"Inspector identifies assigned sole copy")
	check(gear.rejection_reason.contains("All copies") and gear.rejection_reason.contains("Torin"),"Ownership rejection names current wearer")
	check(inventory.grid.item_buttons.hero_bow.has_focus(),"Selected tile retains native focus after rebuild")
	inventory.filter_buttons.equipment.pressed.emit()
	await frames()
	check(inventory.filter_buttons.equipment.has_focus(),"Category retains native focus after rebuild")
	inventory.grid.item_buttons.salvaged_shield.pressed.emit()
	await frames()
	check(not gear.equip_button.disabled,"One-handed Bran can equip free shield")
	gear.equip_button.pressed.emit()
	await frames()
	gear=app.find_child("EquipmentView",true,false)
	inventory=app.find_child("InventoryView",true,false)
	check(campaign.state.equipment[BRAN].off_hand=="salvaged_shield","Normal equip assigns owned shield")
	check(inventory.grid.item_buttons.salvaged_shield.has_focus(),"Equip refresh keeps selected native tile focus")
	inventory.grid.item_buttons.hero_greatsword.pressed.emit()
	await frames()
	check(gear.equip_button.disabled and gear.rejection_reason.contains("Off hand first"),"Greatsword conflict explains exact slot")
	before=campaign.state.duplicate(true)
	gear.equip_button.pressed.emit()
	check(campaign.state==before,"Disabled equip cannot auto-remove shield")
	gear.slot_buttons.off_hand.pressed.emit()
	await frames()
	gear.unequip_button.pressed.emit()
	await frames()
	gear=app.find_child("EquipmentView",true,false)
	inventory=app.find_child("InventoryView",true,false)
	inventory.grid.item_buttons.hero_greatsword.pressed.emit()
	await frames()
	gear.equip_button.pressed.emit()
	await frames()
	gear=app.find_child("EquipmentView",true,false)
	inventory=app.find_child("InventoryView",true,false)
	check(campaign.state.equipment[BRAN].main_hand=="hero_greatsword" and campaign.state.equipment[BRAN].off_hand==null,"Explicit removal enables legal greatsword")
	inventory.grid.item_buttons.salvaged_shield.pressed.emit()
	await frames()
	check(gear.equip_button.disabled and gear.rejection_reason.contains("Unequip Weapon first"),"Shield conflict explains two occupied hands")
	inventory.grid.item_buttons.patched_leather.pressed.emit()
	await frames()
	gear.equip_button.pressed.emit()
	await frames()
	gear=app.find_child("EquipmentView",true,false)
	check(gear.ownership_label.text.contains("Available 1") and gear.ownership_label.text.contains("Bran (Armor)"),"Second owned copy remains available")
	gear.hero_buttons[TORIN].pressed.emit()
	await frames()
	check(not gear.equip_button.disabled,"Free second armor can be equipped on other hero")
	gear.equip_button.pressed.emit()
	await frames()
	gear=app.find_child("EquipmentView",true,false)
	inventory=app.find_child("InventoryView",true,false)
	check(gear.ownership_label.text.contains("Available 0") and gear.ownership_label.text.contains("Bran (Armor)") and gear.ownership_label.text.contains("Torin (Armor)"),"Both named assignments refresh")
	check(campaign.state.items.count("patched_leather")==2,"Assignment never consumes inventory")
	inventory.filter_buttons.all.pressed.emit()
	await frames()
	inventory.entries_scroll.scroll_vertical=350
	await frames()
	var scroll: int=inventory.entries_scroll.scroll_vertical
	check(scroll>0,"Long inventory actually scrolls")
	inventory.highlight_slot("main_hand")
	await frames()
	check(inventory.entries_scroll.scroll_vertical==scroll,"Highlight refresh retains scroll position")
	inventory.filter_buttons.legacy.pressed.emit()
	await frames()
	inventory.restore_position(0,"hero_bow")
	await frames()
	check(inventory.filter_buttons.legacy.has_focus(),"Filtered-out focus target falls back to visible category")
	app.queue_free()
	await frames()
	print("EQUIPMENT_USABILITY: %s checks, %s failures" % [checks,failures.size()])
	for failure in failures: push_error(failure)
	quit(0 if failures.is_empty() else 1)
