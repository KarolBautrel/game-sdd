# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Binary assets
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Preserve checksummed source deliveries byte-for-byte (including upstream EOL).
# Binary extension rules above continue to use Git LFS.
assets_src/characters/painted_candidates/** -text -whitespace
assets_src/characters/surface_refinement/** -text -whitespace
assets_src/characters/mpfb_warden/** -text -whitespace
assets_src/characters/mpfb_warden_outfit/** -text -whitespace
assets_src/characters/mpfb_warden_boots_only/** -text -whitespace
assets_src/characters/warden_motion_pilot/** -text -whitespace

# Preserve upstream formatting in vendored code and original license notices.
assets_src/vendor/** -whitespace
addons/theme_gen/** -whitespace
addons/theme_gen_save_sync/** -whitespace
assets/ui/fonts/*-OFL.txt -whitespace
resources/licenses/shikashi-original.txt -whitespace
resources/licenses/kenney-*.txt -whitespace
